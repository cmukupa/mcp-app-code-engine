# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# ── MCP Server ───────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=<generate-32-byte-hex>

# ── Chatbot App ──────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-48-byte-hex>

# URL of the deployed MCP server — fill in after Step 5.4.3
MCP_SERVER_URL=https://mcp-app-code-engine-mcp-server.<id>.us-south.codeengine.appdomain.cloud

# Demo user passwords (loaded by chatbot-app/src/auth.ts)
DEMO_USER_PASSWORD=<choose-a-strong-password>
ALICE_USER_PASSWORD=<choose-a-strong-password>

# ── Optional ─────────────────────────────────────────────────
PORT=8080
